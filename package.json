{
  "name": "region-snap",
  "productName": "Region Snap",
  "version": "1.1.0",
  "private": true,
  "description": "Region screenshot utility for Windows and Chrome",
  "main": "desktop/main.cjs",
  "author": "vannt-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vannt-dev/region-snap.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check background.js && node --check geometry.js && node --check content.js && node --check popup.js && node --check desktop/capture-utils.cjs && node --check desktop/i18n.js && node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/overlay.js && node --check desktop/settings-preload.cjs && node --check desktop/settings.js",
    "ci": "npm run check && npm run format:check && npm run lint && npm test && npm run build && npm run validate",
    "clean": "node scripts/clean.mjs",
    "desktop:start": "electron desktop/main.cjs",
    "desktop:pack": "electron-builder --dir --win --x64 --publish never",
    "desktop:dist": "electron-builder --win nsis --x64 --publish never",
    "desktop:test": "node scripts/test-desktop.mjs",
    "docs:preview": "node scripts/serve-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:store": "npm run build && node scripts/package-store.mjs",
    "smoke": "node scripts/smoke.mjs",
    "store:assets": "node scripts/generate-store-assets.mjs",
    "test": "node tests/run-tests.js",
    "validate": "node scripts/validate.mjs"
  },
  "build": {
    "appId": "dev.vannt.region-snap.desktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "geometry.js",
      "icons/**/*",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon256.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Region Snap",
      "artifactName": "Region-Snap-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.0.1",
    "globals": "^17.12.0",
    "playwright": "^1.55.0",
    "prettier": "^3.9.7"
  }
}
